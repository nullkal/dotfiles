{{ if eq .chezmoi.os "linux" -}}
{{ if eq .chezmoi.osRelease.id "ubuntu" -}}
#!/bin/sh
set -eu

sudo apt-get update

{{ if .packages.ubuntu.apt_repos -}}
sudo apt-get install -y software-properties-common
{{ range .packages.ubuntu.apt_repos -}}
sudo add-apt-repository --yes --no-update {{ . | quote }}
{{ end -}}
sudo apt-get update
{{ end -}}

{{ if .packages.ubuntu.apt -}}
sudo apt-get install -y {{ range .packages.ubuntu.apt -}}{{ . | quote }} {{ end }}
{{ end -}}

{{ end -}}
{{ end -}}

