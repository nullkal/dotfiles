# open command
{{ if eq .chezmoi.os "linux" -}}
{{   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
  alias open=explorer.exe
{{ else -}}
  alias open=xdg-open
{{   end -}}
{{ else if .chezmoi.os "darwin" -}}
  alias open=/usr/bin/open
{{ end }}


# nvim alias
if type "nvim" > /dev/null; then
  alias vi="nvim"
  alias vim="nvim"
fi


{{ if eq .chezmoi.os "linux" -}}
{{   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
  alias ssh='ssh.exe'
  alias ssh-add='ssh-add.exe'
{{ end }}
{{ end }}
